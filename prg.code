GT LF@condition LF@%param2 LF@str_len
JUMPIFEQ $substr_error LF@condition bool@true
EQ LF@condition LF@%param2 LF@str_len
JUMPIFEQ $substr_error LF@condition bool@true
LT LF@condition LF@%param3 int@0
JUMPIFEQ $substr_error LF@condition bool@true
MOVE LF@max_n LF@str_len
SUB LF@max_n LF@max_n LF@%param2
GT LF@condition LF@%param3 LF@max_n
JUMPIFNEQ $substr_loop LF@condition bool@true
MOVE LF@%param3 LF@max_n
LABEL $substr_loop
GETCHAR LF@char LF@%param1 LF@%param2
CONCAT LF@%retval1 LF@%retval1 LF@char
